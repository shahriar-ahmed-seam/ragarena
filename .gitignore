# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Env / secrets
.env
.env.local
*.pem

# RAGArena caches & scratch
# NOTE: results/ is deliberately NOT ignored. Committed run artefacts are the
# point of the project and the leaderboard site builds from them.
.ragarena_cache/
.cache_*/
*.sqlite
*.sqlite-wal
*.sqlite-shm
# Anchored to the repo root on purpose: an unanchored `runs/` would also match
# site/app/runs/, which silently dropped the leaderboard's run pages from a
# commit and shipped a site with dead links.
/runs/
*.local.json
_*.log

# Node / Next.js
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo
next-env.d.ts

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
