# ---------------------------------------------------------------------------
# RAGArena configuration. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Generator / judge LLM (OpenAI-compatible chat completions) -------------
# DeepSeek is the default. Any OpenAI-compatible endpoint works (Ollama,
# OpenAI, Together, vLLM, ...): just point RAGARENA_LLM_BASE_URL at it.
DEEPSEEK_API_KEY=
RAGARENA_LLM_BASE_URL=https://api.deepseek.com
RAGARENA_GENERATOR_MODEL=deepseek-v4-flash
RAGARENA_JUDGE_MODEL=deepseek-v4-pro

# --- Embeddings -------------------------------------------------------------
# provider: voyage | fastembed | hash
RAGARENA_EMBED_PROVIDER=voyage
RAGARENA_EMBED_MODEL=voyage-4-lite
VOYAGE_API_KEY=

# --- Reranking --------------------------------------------------------------
# provider: voyage | crossencoder | none
RAGARENA_RERANK_PROVIDER=voyage
RAGARENA_RERANK_MODEL=rerank-2.5-lite

# --- Rate limiting ----------------------------------------------------------
# Client-side pacing, requests per minute. 0 disables it. Voyage accounts with
# no payment method on file are capped at 3 RPM / 10K TPM, so set this to 3
# rather than fighting 429s.
RAGARENA_VOYAGE_RPM=0
RAGARENA_LLM_RPM=0

# --- Runner behaviour -------------------------------------------------------
RAGARENA_CONCURRENCY=4
RAGARENA_CACHE_DIR=.ragarena_cache
RAGARENA_CACHE_ENABLED=true

# --- Optional: pgvector index backend --------------------------------------
# Any Postgres with the `vector` extension (Neon, Supabase, RDS, local).
DATABASE_URL=
